# URL of the Django REST API (no trailing slash).
# Local dev: http://localhost:8000/api
#
# Production (Vercel): the Render backend, e.g.
# https://timeline-backend.onrender.com/api
# Set VITE_API_URL in the Vercel project dashboard → Settings →
# Environment Variables. It is baked into the JS bundle at build time.
#
# Alternatively, the vercel.json "rewrites" rule proxies /api/* to
# https://timeline-backend.onrender.com/api/* automatically — in that
# case you don't need VITE_API_URL in Vercel (the default "/api" works).
VITE_API_URL=http://localhost:8000/api

# Public URL of this site — used for canonical links and Open Graph tags
VITE_SITE_URL=http://localhost:5173

# NOTE: Never put secret keys (e.g. PAYSTACK_SECRET_KEY) in this file.
# Everything prefixed with VITE_ is bundled into the public JavaScript.
