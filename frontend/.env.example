# URL of the Django REST API (no trailing slash).
# Local dev: http://localhost:8000/api
#
# Production (Vercel): the Render backend, e.g.
# https://timeline-backend.onrender.com/api
# Set VITE_API_URL in the Vercel project dashboard → Settings →
# Environment Variables. It is baked into the JS bundle at build time.
#
# Alternatively, the vercel.json "rewrites" rule proxies /api/* to
# https://timeline-backend.onrender.com/api/* automatically — in that
# case you don't need VITE_API_URL in Vercel (the default "/api" works).
VITE_API_URL=http://localhost:8000/api

# Public URL of this site — used for canonical links and Open Graph tags
VITE_SITE_URL=http://localhost:5173

# Google Sign-In — the OAuth web client ID from Google Cloud Console.
# This is public (it is meant to ship in the browser bundle). The matching
# GOOGLE_CLIENT_ID must also be set in the backend environment.
# Google Console -> APIs & Services -> Credentials -> OAuth client ID:
#   Authorised JavaScript origins:
#     http://localhost:5173
#     http://127.0.0.1:5173
#     https://timelinegadgets.com
#     https://www.timelinegadgets.com
VITE_GOOGLE_CLIENT_ID=

# NOTE: Never put secret keys (e.g. PAYSTACK_SECRET_KEY or GOOGLE_CLIENT_SECRET)
# in this file. Everything prefixed with VITE_ is bundled into public JavaScript.
