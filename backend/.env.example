# ---------------------------------------------------------------------------
# Timeline Gadgets — backend environment
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Generate one with:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=

# PostgreSQL connection string: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# Local development (default): postgres://postgres:postgres@localhost:5432/timeline_db
# Supabase (production): copy the "Session pooler" URI from Project → Connect, e.g.
#   postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
# Supabase (production): paste the SESSION POOLER URI from Project → Connect, e.g.
#   postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
# Connection lifetime: 0 = open/close per request (portable); always-on hosts
# like Render can reuse connections — set 60+ there, or leave it unset (the
# code defaults to 60 in production).
DB_CONN_MAX_AGE=

# ---------------------------------------------------------------------------
# Cloudinary — cloud storage for product/category/brand images
# (backend/apps/core/storage.py). Leave empty locally to store files in
# backend/media/ instead. Production REQUIRES all three (see prod.py);
# find the keys under Console → API Keys at https://console.cloudinary.com
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Where the React app runs (used for CORS, email links and payment callbacks)
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Paystack (https://dashboard.paystack.com/#/settings/developers)
# The SECRET key stays on the server only. Do not put it in the frontend.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# When no secret key is set and DEBUG=True, a clearly-labelled test mode
# lets you complete checkout locally without charging anyone.
PAYMENT_TEST_MODE=True
# Production escape hatch: allow a deploy before Paystack exists. Checkout
# then reports "payment not configured" and orders stay unpaid. Remove once
# PAYSTACK_SECRET_KEY is set (the flag is ignored from then on).
ALLOW_MISSING_PAYSTACK=

# Email (console backend prints emails to the terminal in development)
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Transactional email — Brevo (primary) with the Django backend as fallback.
# Full walkthrough: EMAIL_SETUP.md at the repo root.
# BREVO_API_KEY stays on the server; never put it in the frontend or commit it.
# Until BREVO_API_KEY is set, email goes to the Django backend above (console
# in development, SMTP/console in production).
# ---------------------------------------------------------------------------
BREVO_API_KEY=
BREVO_SENDER_NAME=Timeline Gadgets
# Must be a sender verified in Brevo (Senders, Domains & Dedicated IPs → Senders).
BREVO_SENDER_EMAIL=timelinegadget@gmail.com
BREVO_REPLY_TO_EMAIL=timelinegadget@gmail.com
BREVO_API_URL=https://api.brevo.com/v3
BREVO_API_TIMEOUT=15

# Safety switch: in test mode every message is redirected instead of delivered
# to customers. With no EMAIL_TEST_RECIPIENT the message is only printed to the
# terminal. Development defaults to True; production settings force it False.
EMAIL_TEST_MODE=True
# Where test-mode emails are redirected (e.g. your own inbox). Leave blank to
# capture messages in the console instead of sending them anywhere.
EMAIL_TEST_RECIPIENT=

# Delivery policy for the durable email outbox (apps/notifications).
EMAIL_MAX_ATTEMPTS=5
EMAIL_IMMEDIATE_ATTEMPTS=2
EMAIL_RETRY_AFTER_MINUTES=10

# Store settings (Naira)
LOW_STOCK_THRESHOLD=5
SHIPPING_FEE_LAGOS=3500
SHIPPING_FEE_SOUTH_WEST=5500
SHIPPING_FEE_DEFAULT=7500
FREE_SHIPPING_THRESHOLD=1000000
UNPAID_ORDER_EXPIRY_HOURS=48
# Token for the maintenance endpoint that cancels expired unpaid orders and
# releases their stock (called hourly by .github/workflows/maintenance.yml in
# production). Leave blank in development — the endpoint stays disabled.
MAINTENANCE_TOKEN=
REVIEWS_REQUIRE_APPROVAL=False



# ---------------------------------------------------------------------------
# AI chat — the customer Shopping Assistant (apps/ai_chat). Only one provider
# key is needed; GROQ is tried first, then XAI. Keys stay on the server.
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
# Optional fallback provider
XAI_API_KEY=
XAI_MODEL=grok-3-mini
# Per-user rate limit for the assistant endpoint
THROTTLE_AI_CHAT=30/min
# Support contact quoted by the Shopping Assistant (must match the floating
# WhatsApp button in the frontend)
SUPPORT_WHATSAPP=2347062895442
