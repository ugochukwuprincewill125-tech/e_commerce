# ---------------------------------------------------------------------------
# Timeline Gadgets — backend environment
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Generate one with:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=

# PostgreSQL connection string: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# Local development (default): postgres://postgres:postgres@localhost:5432/timeline_db
# Supabase (production): copy the "Session pooler" URI from Project → Connect, e.g.
#   postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
# Supabase (production): paste the SESSION POOLER URI from Project → Connect, e.g.
#   postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
# Connection lifetime: 0 = open/close per request (portable); always-on hosts
# like Render can reuse connections — set 60+ there, or leave it unset (the
# code defaults to 60 in production).
DB_CONN_MAX_AGE=

# ---------------------------------------------------------------------------
# Cloudinary — cloud storage for product/category/brand images
# (backend/apps/core/storage.py). Leave empty locally to store files in
# backend/media/ instead. Production REQUIRES all three (see prod.py);
# find the keys under Console → API Keys at https://console.cloudinary.com
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Where the React app runs (used for CORS, email links and payment callbacks)
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Contact form inbox
# Every contact-form submission is stored in the admin Messages tab and a
# copy is emailed to this address. Keep it server-side only.
# ---------------------------------------------------------------------------
CONTACT_NOTIFICATION_EMAIL=timelinegadgets4@gmail.com

# ---------------------------------------------------------------------------
# Google Sign-In
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Add your storefront origins under "Authorised JavaScript
# origins", e.g. http://localhost:5173, http://127.0.0.1:5173 and
# https://timelinegadgets.com. The same client ID must be set as
# VITE_GOOGLE_CLIENT_ID in frontend/.env.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_TOKENINFO_URL=https://oauth2.googleapis.com/tokeninfo
GOOGLE_API_TIMEOUT=10

# Paystack (https://dashboard.paystack.com/#/settings/developers)
# The SECRET key stays on the server only. Do not put it in the frontend.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# When no secret key is set and DEBUG=True, a clearly-labelled test mode
# lets you complete checkout locally without charging anyone.
PAYMENT_TEST_MODE=True
# Production escape hatch: allow a deploy before Paystack exists. Checkout
# then reports "payment not configured" and orders stay unpaid. Remove once
# PAYSTACK_SECRET_KEY is set (the flag is ignored from then on).
ALLOW_MISSING_PAYSTACK=

# Email (console backend prints emails to the terminal in development)
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Transactional email - Brevo (primary) with the Django backend as fallback.
# Full walkthrough: EMAIL_SETUP.md at the repo root.
# BREVO_API_KEY stays on the server; never put it in the frontend or commit it.
# Without a key, development prints to the console; production marks the outbox
# row failed instead of pretending it was delivered.
# ---------------------------------------------------------------------------
BREVO_API_KEY=
BREVO_SENDER_NAME=Timeline Gadgets
# The From address. It must be a sender verified in Brevo (Senders, Domains &
# Dedicated IPs → Senders). A Gmail address works for a quick test, but Gmail
# only accepts mail whose SPF/DKIM passes for the domain in the From header:
# Brevo rewrites a free-mailbox sender to a shared brevosend.com address and
# Gmail drops the message instead of delivering it. Use an address on the
# authenticated store domain — see section 6 of EMAIL_SETUP.md.
BREVO_SENDER_EMAIL=timelinegadgets4@gmail.com
# Replies should still reach a mailbox that is watched.
BREVO_REPLY_TO_EMAIL=timelinegadgets4@gmail.com
BREVO_API_URL=https://api.brevo.com/v3
BREVO_API_TIMEOUT=15

# Safety switch: in test mode every message is redirected instead of delivered
# to customers. With no EMAIL_TEST_RECIPIENT the message is only printed to the
# terminal. Development defaults to True; production settings force it False.
EMAIL_TEST_MODE=True
# Where test-mode emails are redirected (e.g. your own inbox). Leave blank to
# capture messages in the console instead of sending them anywhere.
EMAIL_TEST_RECIPIENT=

# Delivery policy for the durable email outbox (apps/notifications).
EMAIL_MAX_ATTEMPTS=5
EMAIL_IMMEDIATE_ATTEMPTS=2
EMAIL_RETRY_AFTER_MINUTES=10
# Never record console-only output as a successful delivery. Production
# forces this on; it is only useful to turn off in development.
EMAIL_REQUIRE_REAL_PROVIDER=

# Store settings (Naira)
LOW_STOCK_THRESHOLD=5
# Delivery fees (Naira). Lagos metro uses local dispatch riders; the other
# bands are based on live courier quotes (see docs/delivery-fee-research.md).
SHIPPING_FEE_LAGOS=3500
SHIPPING_FEE_SOUTH_WEST=6500
SHIPPING_FEE_SOUTH_EAST_SOUTH_SOUTH=8000
SHIPPING_FEE_NORTH=9000
SHIPPING_FEE_DEFAULT=9000
FREE_SHIPPING_THRESHOLD=1000000
UNPAID_ORDER_EXPIRY_HOURS=48
# One reminder is emailed this many minutes after checkout. If payment is
# still missing after the grace period, the order is permanently deleted and
# its stock returned to inventory. The scheduled GitHub workflow calls the
# endpoint that runs this sweep every 10 minutes in production.
UNPAID_ORDER_REMINDER_MINUTES=15
UNPAID_ORDER_DELETION_GRACE_MINUTES=60
# Production enables a best-effort sweep while the API is awake. Leave this
# blank/false in development so running the site does not send automated
# customer email. The scheduled maintenance endpoint is always the fallback.
UNPAID_ORDER_SWEEP_ON_REQUEST=False
# Token for the maintenance endpoints that send reminders, delete expired
# unpaid orders and cancel stale legacy ones (called by the GitHub workflows
# in production). Leave blank in development — the endpoints stay disabled.
MAINTENANCE_TOKEN=
REVIEWS_REQUIRE_APPROVAL=False



# ---------------------------------------------------------------------------
# AI chat — the customer Shopping Assistant (apps/ai_chat). Only one provider
# key is needed; GROQ is tried first, then XAI. Keys stay on the server.
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
# Optional fallback provider
XAI_API_KEY=
XAI_MODEL=grok-3-mini
# Per-user rate limit for the assistant endpoint
THROTTLE_AI_CHAT=30/min
# Support contact quoted by the Shopping Assistant (must match the floating
# WhatsApp button in the frontend)
SUPPORT_WHATSAPP=2347062895442
