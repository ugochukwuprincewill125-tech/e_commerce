# ---------------------------------------------------------------------------
# Timeline Global Systems — backend environment
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Generate one with:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL connection string: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# Local development (default): postgres://postgres:postgres@localhost:5432/timeline_db
# Supabase (production): copy the "Session pooler" URI from Project → Connect, e.g.
#   postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/timeline_db
# Supabase (production): paste the SESSION POOLER URI from Project → Connect, e.g.
#   postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
# Connection lifetime: 0 = open/close per request (required for Supabase session
# pooler and serverless hosts like Vercel). Set 60+ only for always-on servers.
DB_CONN_MAX_AGE=0

# ---------------------------------------------------------------------------
# Backblaze B2 — cloud storage for product/category/brand images
# (backend/apps/core/storage.py). Leave empty locally to store files in
# backend/media/ instead. Create the bucket at https://secure.backblaze.com
# ---------------------------------------------------------------------------
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=timeline-media
# Endpoint of the region your bucket lives in (Bucket Details → Endpoint), e.g.
B2_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
# Public base URL of the bucket (or your Cloudflare/CDN custom domain). Used to
# build absolute image URLs when the request host should not be trusted.
B2_PUBLIC_BASE_URL=https://f005.backblazeb2.com/file/timeline-media

# Where the React app runs (used for CORS, email links and payment callbacks)
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Paystack (https://dashboard.paystack.com/#/settings/developers)
# The SECRET key stays on the server only. Do not put it in the frontend.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# When no secret key is set and DEBUG=True, a clearly-labelled test mode
# lets you complete checkout locally without charging anyone.
PAYMENT_TEST_MODE=True

# Email (console backend prints emails to the terminal in development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Timeline Global Systems <timelinegadget@gmail.com>

# Store settings (Naira)
LOW_STOCK_THRESHOLD=5
SHIPPING_FEE_LAGOS=3500
SHIPPING_FEE_SOUTH_WEST=5500
SHIPPING_FEE_DEFAULT=7500
FREE_SHIPPING_THRESHOLD=1000000
UNPAID_ORDER_EXPIRY_HOURS=48
REVIEWS_REQUIRE_APPROVAL=False
